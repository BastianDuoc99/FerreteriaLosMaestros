# Ejemplo de variables de entorno del backend.
# Copiar a .env y exportarlas antes de iniciar Spring Boot (Spring no lee .env automáticamente).

# --- Perfil MySQL (recomendado para la evaluación) ---
DB_URL=jdbc:mysql://127.0.0.1:3306/ferreteria?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USER=ferreteria
DB_PASSWORD=ferreteria123
DDL_AUTO=update

# --- Seguridad (valor de demostración, NO es un secreto real) ---
JWT_SECRET=cambiar-este-valor-en-entrega-1234567890
JWT_EXPIRATION_MS=3600000

# --- Orígenes permitidos por CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En PowerShell:
#   Get-Content .env.example | ForEach-Object {
#     if ($_ -match '^([^#][^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2], 'Process') }
#   }
