{
  "info": {
    "name": "Ferretería Los Maestros EP3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Registro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"run\": \"12345678-5\",\n  \"nombre\": \"María\",\n  \"apellidos\": \"González\",\n  \"email\": \"nuevo@duoc.cl\",\n  \"password\": \"1234\",\n  \"direccion\": \"Av. Siempre Viva 123\",\n  \"region\": \"Región de Coquimbo\",\n  \"comuna\": \"La Serena\",\n  \"tipoCliente\": \"Contratista\",\n  \"cuentaCorriente\": true\n}"
        },
        "url": "{{baseUrl}}/auth/registro"
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@duoc.cl\",\n  \"password\": \"1234\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Auth - Perfil",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Productos - Listar",
      "request": { "method": "GET", "url": "{{baseUrl}}/productos" }
    },
    {
      "name": "Productos - Crear",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"NUEVO01\",\n  \"categoria\": \"Varios / Ferretería general\",\n  \"subcategoria\": \"Prueba\",\n  \"nombre\": \"Producto de prueba\",\n  \"marca\": \"Demo\",\n  \"unidad\": \"Unidad\",\n  \"precioCompra\": 1000,\n  \"precio\": 1990,\n  \"stock\": 10,\n  \"stockMinimo\": 2\n}"
        },
        "url": "{{baseUrl}}/productos"
      }
    },
    {
      "name": "Pedidos - Crear",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [{ \"codigo\": \"MC001\", \"qty\": 2 }],\n  \"entrega\": \"retiro\",\n  \"pago\": \"contado\",\n  \"direccion\": \"\"\n}"
        },
        "url": "{{baseUrl}}/pedidos"
      }
    },
    {
      "name": "Pedidos - Míos",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/pedidos/mios"
      }
    },
    {
      "name": "Usuarios - Listar (Admin)",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/usuarios"
      }
    },
    {
      "name": "Contacto - Enviar",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"María\",\n  \"email\": \"alumna@duoc.cl\",\n  \"mensaje\": \"Quiero cotizar cemento.\"\n}"
        },
        "url": "{{baseUrl}}/contacto"
      }
    }
  ]
}
